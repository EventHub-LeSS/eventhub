{
  "realm": "eventhub",
  "enabled": true,
  "displayName": "EventHub",
  "loginTheme": "eventhub",
  "organizationsEnabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "organizations": [
    {
      "name": "Provadis Hochschule",
      "alias": "provadis-hochschule",
      "enabled": true,
      "description": "Demo organization",
      "domains": [
        {
          "name": "provadis-hochschule.de",
          "verified": false
        }
      ],
      "members": [
        {
          "username": "organizer@provadis-hochschule.de"
        },
        {
          "username": "großmeister_finn"
        }
      ]
    },
    {
      "name": "Telekom",
      "alias": "telekom",
      "enabled": true,
      "description": "Demo organization",
      "members": [
        {
          "username": "organizer@telekom.de"
        },
        {
          "username": "großmeister_finn"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "defaultClientScopes": [
        "profile",
        "roles",
        "backend-audience"
      ],
      "optionalClientScopes": [
        "organization"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "backend",
      "name": "Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "eventhub-backend-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "visitor@eventhub.de",
      "email": "visitor@eventhub.de",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Merz",
      "lastName": "Leck Eier1",
      "credentials": [
        {
          "type": "password",
          "value": "password",
