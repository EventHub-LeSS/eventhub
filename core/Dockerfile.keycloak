# Keycloakify needs Java and Maven to package the theme, so the build happens here
# instead of on every developer machine.
FROM oven/bun:1-alpine AS theme

# nodejs/npm are needed too: keycloakify's postinstall shells out to `npx`.
RUN apk add --no-cache openjdk17 maven git nodejs npm

WORKDIR /theme
COPY keycloak-theme/ ./

# sync-extensions (postinstall) diffs against git to know which files were ejected.
RUN git init -q . \
    && git add -A \
    && git -c user.email=build@eventhub.test -c user.name=build commit -qm "build" \
    && bun install --frozen-lockfile

RUN bun run build-keycloak-theme

# realm-sync applies the realm file to a running server non-destructively (see
# entrypoint-realm-override.sh). It is a tiny dependency-free Go tool, built
# here so that the Keycloak image stays self-contained.
FROM golang:1.26.5-alpine AS realm-sync

WORKDIR /src
COPY realm-sync/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /realm-sync .

FROM quay.io/keycloak/keycloak:26.7

COPY --from=theme \
    /theme/dist_keycloak/keycloak-theme-for-kc-all-other-versions.jar \
    /opt/keycloak/providers/eventhub-theme.jar

RUN mkdir -p /opt/keycloak/data/import
COPY --chown=1000:0 --chmod=644 realms/eventhub-realm.json /opt/keycloak/data/import/eventhub-realm.json
COPY --chown=1000:0 --chmod=755 entrypoint-realm-override.sh /opt/keycloak/entrypoint-realm-override.sh
COPY --from=realm-sync --chown=1000:0 --chmod=755 /realm-sync /opt/keycloak/realm-sync

RUN sed -i 's/\r$//' /opt/keycloak/entrypoint-realm-override.sh

ENTRYPOINT ["/opt/keycloak/entrypoint-realm-override.sh"]
CMD ["start", "--import-realm"]